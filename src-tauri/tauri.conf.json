{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FPS Cagoule",
  "version": "0.21.0",
  "identifier": "ch.lucas-chvnn.fps-cagoule",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Lucas Chavanne",
    "shortDescription": "Analyse, optimisation et boost par jeu",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/PresentMon.exe": "PresentMon.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2ODEwODI3QTNFN0YzNzQKUldSMDgrZWpKd2lCSnVyTlU1NTQxS1JHUGZBLzU5Zit2Uy9aSmpiNS91QzBWT0dyaEpyS3RvdloK",
      "endpoints": [
        "https://github.com/lucas-chvnn-info/fps-cagoule/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}